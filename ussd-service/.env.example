# Supabase: Project Settings > API (server-side use only).
SUPABASE_URL=
# Supabase: Project Settings > API > service_role key (server-side use only).
SUPABASE_SERVICE_ROLE_KEY=
# Supabase: Project Settings > API > publishable/anon key (browser/public use only).
SUPABASE_ANON_KEY=

# Africa's Talking: create/get credentials in your Africa's Talking account.
AT_USERNAME=
# Africa's Talking: API Key from your account settings.
AT_API_KEY=
# Africa's Talking: optional approved sender ID; leave blank if not using one.
AT_SENDER_ID=

# Supabase: set this to the same random value configured on the SMS Database Webhook.
WEBHOOK_SECRET=
# Vercel/GitHub Pages/Supabase: public base URL of the deployed website.
SITE_URL=

# USSD callback security and routing.
USSD_CALLBACK_TOKEN=
# Africa's Talking: configure this shortcode in your USSD callback setup.
USSD_SERVICE_CODE=*384*16855#
USSD_SESSION_TTL_SECONDS=
USSD_RATE_LIMIT_PER_MINUTE=
USSD_TRUST_PROXY=

# Optional server/runtime settings.
LOCAL_USSD_DEMO=
USSD_SIMULATOR_ENABLED=
NODE_ENV=
PORT=
HOST=
